# Shared high scores (MariaDB; compose.yaml provides one for development). Without DB_HOST, each
# browser keeps its own high scores.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=24games
DB_PASSWORD=24games
DB_NAME=24games
# DB_POOL_SIZE=5
# DB_TLS=false

# HTTP
# LISTEN_HOST=127.0.0.1                # use 0.0.0.0 in containers
# PORT=3000                            # the Vite dev server proxies /api to this port
# PUBLIC_URL=https://games.example.com # external origin, checked against score submissions
# SCORES_PER_MINUTE=30                 # per table, against floods

# Integration tests (npm test) against the compose MariaDB; unset to skip them
# TEST_DB_HOST=127.0.0.1
# TEST_DB_USER=24games
# TEST_DB_PASSWORD=24games
# TEST_DB_NAME=games24_test
